<UserControl x:Class="Melody.UI.MenuWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Melody.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#2C3E50">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="🎹 Melody" 
                       FontSize="36" 
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,50"/>

            <Button Content="Gyakorlás indítása" 
                    Command="{Binding StartPracticeCommand}"
                    Height="50" 
                    FontSize="18"
                    Margin="0,10"
                    Background="#27AE60"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button Content="Lejátszó" 
                    Command="{Binding PlayerCommand}"
                    Height="50" 
                    FontSize="18"
                    Margin="0,10"
                    Background="#3498DB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button Content="Beállítások" 
                    Command="{Binding SettingsCommand}"
                    Height="50" 
                    FontSize="18"
                    Margin="0,10"
                    Background="Yellow"
                    Foreground="Black"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button Content="Kilépés" 
                    Command="{Binding ExitCommand}"
                    Height="50" 
                    FontSize="18"
                    Margin="0,10"
                    Background="#E74C3C"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
