<UserControl x:Class="Melody.UI.MenuWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Melody.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource MainBackgroundBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="🎹 Melody" 
                       FontSize="36" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppNameForeground}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,50"/>

            <Button Content="Practice" 
                    Command="{Binding StartPracticeCommand}"
                    Height="50" 
                    FontSize="18"
                    Margin="0,10"
                    Background="{DynamicResource PracticeButtonBackground}"
                    Foreground="{DynamicResource PracticeButtonForeground}"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button Content="Player" 
                    Command="{Binding PlayerCommand}"
                    Height="50" 
                    FontSize="18"
                    Margin="0,10"
                    Background="{DynamicResource PlayerButtonBackground}"
                    Foreground="{DynamicResource PlayerButtonForeground}"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button Content="Settings" 
                    Command="{Binding SettingsCommand}"
                    Height="50" 
                    FontSize="18"
                    Margin="0,10"
                    Background="{DynamicResource SettingsButtonBackground}"
                    Foreground="{DynamicResource SettingsButtonForeground}"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button Content="Exit" 
                    Command="{Binding ExitCommand}"
                    Height="50" 
                    FontSize="18"
                    Margin="0,10"
                    Background="{DynamicResource ExitButtonBackground}"
                    Foreground="{DynamicResource ExitButtonForeground}"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
