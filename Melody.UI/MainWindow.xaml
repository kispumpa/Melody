<Window x:Class="Melody.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Melody.UI" 
        xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
        xmlns:sw="clr-namespace:System.Windows;assembly=PresentationCore" 
        xmlns:svgc="http://sharpvectors.codeplex.com/runtime/" 
        xmlns:svgc1="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="Melody" WindowState="Maximized" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" d:DesignHeight="540" d:DesignWidth="960">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="11*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Load Sheet music" Command="{Binding LoadLilypondCommand}" Margin="0,0,10,0" Padding="10,5" 
                    Visibility="{Binding IsSheetMusicView, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="Load Piano roll" Command="{Binding LoadPianorollCommand}" Margin="0,0,10,0" Padding="10,5"
                    Visibility="{Binding IsPianoRollView, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <ComboBox ItemsSource="{Binding MidiDevices}" SelectedIndex="{Binding SelectedMidiDeviceIndex}" 
                      Width="200" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            <ToggleButton Content="Toggle View" Command="{Binding ToggleViewCommand}" Padding="10,5"/>
            <TextBlock Text="{Binding ViewText}" FontSize="18" FontWeight="Bold" Padding="10,5" VerticalAlignment="Center"/>
        </StackPanel>

        
        <Grid x:Name="pianorollGrid" Grid.Row="1" Visibility="{Binding IsPianoRollView, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>  
           
        </Grid>
        
        
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="Black"
                Visibility="{Binding IsSvgLoaded, Converter={StaticResource BoolToVisibilityConverter}}">

        </Border>
    </Grid>
</Window>
