<UserControl x:Class="Melody.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Melody.UI"
        mc:Ignorable="d"
        d:DesignHeight="540" d:DesignWidth="960">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Upper Control Panel -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{DynamicResource MainBackgroundBrush}">
            <Button Command="{Binding GoHomeCommand}" Style="{StaticResource HomeButtonStyle}" />
            <Button Content="Load Sheet music" Command="{Binding LoadSheetCommand}" Margin="5" Padding="10,5"/>
            <ComboBox ItemsSource="{Binding MidiDevices}" SelectedIndex="{Binding SelectedMidiDeviceIndex}" 
                      Width="200" Margin="5" VerticalContentAlignment="Center"/>
            <ToggleButton Content="Toggle View" Command="{Binding ToggleViewCommand}" Padding="10,5" Margin="5"/>
            <TextBlock Text="{Binding ViewText}" FontSize="18" FontWeight="Bold" Padding="10,5" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Piano Roll View -->
        <Grid x:Name="pianorollGrid" Grid.Row="1" Visibility="{Binding IsPianoRollView, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
        </Grid>

        <!-- Sheet Music View -->
        <Grid x:Name="sheetMusicGrid" Grid.Row="1" ClipToBounds="True"
      Visibility="{Binding IsSheetMusicView, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,-21140,0">

            <!-- Sheet music -->
            <Image x:Name="ImageControl"
   Stretch="None" HorizontalAlignment="Left"  >
                <Image.RenderTransform>
                    <TranslateTransform x:Name="ImageTransform"/>
                </Image.RenderTransform>
            </Image>
            <!-- Play cursor -->
            <Canvas x:Name="highlightCanvas" Background="Transparent" IsHitTestVisible="False">
                <Line x:Name="myPlaybackCursor" Stroke="Red" StrokeThickness="3" 
              X1="100" Y1="0" X2="100" Y2="1000" Visibility="Hidden"/>
            </Canvas>
        </Grid>

        <!-- Playing Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10" HorizontalAlignment="Center" Background="{DynamicResource FooterBackground}">
            <Button x:Name="playButton" Content="▶ Play" Padding="15,5" Margin="5" Click="PlayButton_Click"/>
            <Button x:Name="pauseButton" Content="⏸ Pause" Padding="15,5" Margin="5" Click="PauseButton_Click" IsEnabled="False"/>
            <Button x:Name="stopButton" Content="⏹ Stop" Padding="15,5" Margin="5" Click="StopButton_Click" IsEnabled="False"/>
            <TextBlock x:Name="timeDisplay" Text="00:00 / 00:00" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
        </StackPanel>

        <!--Loading Overlay-->
        <Grid Grid.RowSpan="3" Background="#E62C3E50" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">

                <TextBlock Text="Fájl feldolgozása folyamatban..." 
                   Foreground="White" 
                   FontSize="22" 
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,15"/>

                <ProgressBar IsIndeterminate="True" 
                     Height="8" 
                     Foreground="#3498DB" 
                     Background="#1A252F" 
                     BorderThickness="0"
                     Margin="0,0,0,25"/>

                <Expander Header="Részletek megjelenítése" 
                  Foreground="White" 
                  Background="#34495E" 
                  BorderBrush="#1A252F" 
                  BorderThickness="1">
                    <Border Background="#1A252F" Height="150" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ListBox ItemsSource="{Binding LoadingMessages}" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             Foreground="#BDC3C7">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,4"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </Expander>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>