<Window x:Class="Melody.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Melody.UI" 
        xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
        xmlns:sw="clr-namespace:System.Windows;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="Music Practice app" Height="600" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Load MusicXML" Command="{Binding LoadMusicXmlCommand}" Margin="0,0,10,0" Padding="10,5"/>
            <ComboBox ItemsSource="{Binding MidiDevices}" SelectedIndex="{Binding SelectedMidiDeviceIndex}" 
                      Width="200" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            <ToggleButton Content="Toggle View" Command="{Binding ToggleViewCommand}" Padding="10,5"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Sheet Music View" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" 
                       Visibility="{Binding IsSheetMusicView, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="Piano Roll View" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" 
                       Visibility="{Binding IsPianoRollView, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>
