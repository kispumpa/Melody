<Window x:Class="Melody.UI.SelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Melody.UI"
        mc:Ignorable="d"
        Title="Choose sheet" Height="450" Width="450"
        WindowStartupLocation="CenterScreen">
    <StackPanel>
        <TextBlock Text="Select an item:" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   Margin="10,10,10,0" 
                   VerticalAlignment="Top" />
        <ListBox x:Name="ItemListBox" 
                 DisplayMemberPath="Value" 
                 SelectionChanged="ItemListBox_SelectionChanged" />
    </StackPanel>
</Window>
