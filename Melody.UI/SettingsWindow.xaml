<UserControl x:Class="Melody.UI.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Melody.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource SettingsBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Command="{Binding GoHomeCommand}" Style="{StaticResource HomeButtonStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="50,20,50,20">

                <TextBlock Text="Beállítások" FontSize="36" Foreground="{DynamicResource SettingsMainText}" FontWeight="Bold" Margin="0,0,0,40" />

                <Border Background="{DynamicResource SettingsBorderBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Színtéma" Foreground="{DynamicResource SettingsMainText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Válaszd ki az alkalmazás megjelenését." Foreground="{DynamicResource SettingsSubText}" FontSize="14" Margin="0,0,0,15"/>

                        <ComboBox ItemsSource="{Binding AvailableThemes}" 
                                  SelectedItem="{Binding SelectedTheme}" 
                                  Width="300" 
                                  HorizontalAlignment="Left" 
                                  Padding="8" 
                                  FontSize="14"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SettingsBorderBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Zongoratekercs megjelenítése" Foreground="{DynamicResource SettingsMainText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Állítsd be, hogy a teljes 88 billentyűs zongora látszódjon-e, vagy csak az aktív oktávok." Foreground="{DynamicResource SettingsSubText}" FontSize="14" Margin="0,0,0,15"/>

                        <StackPanel Margin="5,0,0,0">
                            <RadioButton Content="Csak az aktív oktávok (Dinamikus)" 
                                IsChecked="{Binding IsDynamicPianoWidth}" 
                                GroupName="PianoWidthGroup"
                                Foreground="{DynamicResource SettingsOptionText}" FontSize="14">
                                <RadioButton.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                </RadioButton.LayoutTransform>
                            </RadioButton>
                            <RadioButton Content="Teljes zongora (88 billentyű)" 
                                IsChecked="{Binding IsFullPianoWidth}" 
                                GroupName="PianoWidthGroup"
                                Foreground="{DynamicResource SettingsOptionText}" FontSize="14" Margin="0,0,0,10">
                                <RadioButton.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                </RadioButton.LayoutTransform>
                            </RadioButton>
                        </StackPanel>

                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource SettingsBorderBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Nyelv (Language)" Foreground="{DynamicResource SettingsMainText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Válaszd ki az alkalmazás nyelvét. A változtatásokhoz újraindítás lehet szükséges." Foreground="{DynamicResource SettingsSubText}" FontSize="14" Margin="0,0,0,15"/>

                        <ComboBox ItemsSource="{Binding AvailableLanguages}" 
                  SelectedItem="{Binding SelectedLanguage}" 
                  Width="300" 
                  HorizontalAlignment="Left" 
                  Padding="8" 
                  FontSize="14"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource FooterBackground}" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="Mentés" 
                        Command="{Binding SaveSettingsCommand}" 
                        Width="120" Padding="10,8" 
                        Background="{DynamicResource SettingsSaveButtonBackground}" Foreground="{DynamicResource SettingsSaveButtonForeground}" 
                        BorderThickness="0" 
                        FontSize="16" FontWeight="SemiBold" Cursor="Hand"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
