<UserControl x:Class="Melody.UI.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Melody.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#2C3E50">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Command="{Binding GoHomeCommand}" Padding="10,5" Margin="0,0,20,0" Background="#34495E" Foreground="White" BorderThickness="0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" 
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                          Width="16" Height="16" 
                          Stretch="Uniform" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="50,20,50,20">

                <TextBlock Text="Beállítások" FontSize="36" Foreground="White" FontWeight="Bold" Margin="0,0,0,40" />

                <Border Background="#34495E" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Színtéma" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Válaszd ki az alkalmazás megjelenését." Foreground="#BDC3C7" FontSize="14" Margin="0,0,0,15"/>

                        <ComboBox ItemsSource="{Binding AvailableThemes}" 
                                  SelectedItem="{Binding SelectedTheme}" 
                                  Width="300" 
                                  HorizontalAlignment="Left" 
                                  Padding="8" 
                                  FontSize="14"/>
                    </StackPanel>
                </Border>

                <Border Background="#34495E" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Zongoratekercs megjelenítése" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Állítsd be, hogy a teljes 88 billentyűs zongora látszódjon-e, vagy csak az aktív oktávok." Foreground="#BDC3C7" FontSize="14" Margin="0,0,0,15"/>

                        <StackPanel Margin="5,0,0,0">
                            <RadioButton Content="Csak az aktív oktávok (Dinamikus)" 
                                IsChecked="{Binding IsDynamicPianoWidth}" 
                                GroupName="PianoWidthGroup"
                                Foreground="White" FontSize="16">
                                <RadioButton.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                </RadioButton.LayoutTransform>
                            </RadioButton>
                            <RadioButton Content="Teljes zongora (88 billentyű)" 
                                IsChecked="{Binding IsFullPianoWidth}" 
                                GroupName="PianoWidthGroup"
                                Foreground="White" FontSize="16" Margin="0,0,0,10">
                                <RadioButton.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                </RadioButton.LayoutTransform>
                            </RadioButton>
                        </StackPanel>

                    </StackPanel>
                </Border>
                <Border Background="#34495E" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Nyelv (Language)" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Válaszd ki az alkalmazás nyelvét. A változtatásokhoz újraindítás lehet szükséges." Foreground="#BDC3C7" FontSize="14" Margin="0,0,0,15"/>

                        <ComboBox ItemsSource="{Binding AvailableLanguages}" 
                  SelectedItem="{Binding SelectedLanguage}" 
                  Width="300" 
                  HorizontalAlignment="Left" 
                  Padding="8" 
                  FontSize="14"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#1A252F" Padding="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Content="Mentés" 
                        Command="{Binding SaveSettingsCommand}" 
                        Width="120" Padding="10,8" 
                        Background="#27AE60" Foreground="White" 
                        BorderThickness="0" 
                        FontSize="16" FontWeight="SemiBold" Cursor="Hand"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
