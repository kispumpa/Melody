<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#0A0A0A"/>

    <SolidColorBrush x:Key="AppNameForeground" Color="#F0F0F0"/>

    <SolidColorBrush x:Key="PracticeButtonBackground" Color="#808080"/>
    <SolidColorBrush x:Key="PracticeButtonForeground" Color="#0A0A0A"/>
    
    <SolidColorBrush x:Key="PlayerButtonBackground" Color="#4D4D4D"/>
    <SolidColorBrush x:Key="PlayerButtonForeground" Color="White"/>

    <SolidColorBrush x:Key="SettingsButtonBackground" Color="#333333"/>
    <SolidColorBrush x:Key="SettingsButtonForeground" Color="White"/>

    <SolidColorBrush x:Key="ExitButtonBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ExitButtonForeground" Color="#A0A0A0"/>
</ResourceDictionary>