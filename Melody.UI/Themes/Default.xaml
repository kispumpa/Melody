<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--Menu-->
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#2C3E50"/>
    
    <SolidColorBrush x:Key="AppNameForeground" Color="White"/>
    
    <SolidColorBrush x:Key="PracticeButtonBackground" Color="#27AE60"/>
    <SolidColorBrush x:Key="PracticeButtonForeground" Color="Black"/>

    <SolidColorBrush x:Key="PlayerButtonBackground" Color="#3498DB"/>
    <SolidColorBrush x:Key="PlayerButtonForeground" Color="Black"/>
    
    <SolidColorBrush x:Key="SettingsButtonBackground" Color="Yellow"/>
    <SolidColorBrush x:Key="SettingsButtonForeground" Color="Black"/>

    <SolidColorBrush x:Key="ExitButtonBackground" Color="#E74C3C"/>
    <SolidColorBrush x:Key="ExitButtonForeground" Color="Black"/>
    
    <!--Settings-->
    <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#2C3E50"/>
    <SolidColorBrush x:Key="SettingsBorderBrush" Color="#34495E"/>
    
    <SolidColorBrush x:Key="SettingsMainText" Color="White"/>
    <SolidColorBrush x:Key="SettingsSubText" Color="#BDC3C7"/>
    <SolidColorBrush x:Key="SettingsOptionText" Color="White"/>

    <SolidColorBrush x:Key="SettingsSaveButtonBackground" Color="#27AE60"/>
    <SolidColorBrush x:Key="SettingsSaveButtonForeground" Color="White"/>

    <SolidColorBrush x:Key="HomeButtonBackground" Color="#34495E"/>
    <SolidColorBrush x:Key="HomeButtonForeground" Color="White"/>
    <SolidColorBrush x:Key="HomeButtonBorderBrush" Color="White"/>

    <SolidColorBrush x:Key="FooterBackground" Color="#1A252F"/>

    <SolidColorBrush x:Key="PianoRollLeftHandNoteBrush" Color="#5C6BC0"/>
    <SolidColorBrush x:Key="PianoRollRightHandNoteBrush" Color="#FF7043"/>
    

</ResourceDictionary>