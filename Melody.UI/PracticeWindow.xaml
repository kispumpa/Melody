<Window x:Class="Melody.UI.PracticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Melody.UI"
        mc:Ignorable="d"
        Title="PracticeWindow" WindowState="Maximized" d:DesignHeight="540" d:DesignWidth="960">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="11*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button x:Name="btn_startPractice" Content="Start practice" Margin="0,0,20,0" Padding="10,5" Click="StartPracticeButton_Click" IsEnabled="False"/>
            <Button x:Name="btn_retry" Content="Retry" Margin="0,0,20,0" Padding="10,5" Click="RetryButton_Click" IsEnabled="False"/>
            <Button x:Name="btn_continue" Content="Continue practice" Margin="0,0,20,0" Padding="10,5" IsEnabled="False" Click="ContinueButton_Click"/>
            <TextBlock x:Name="practiceDisplay" Text="" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="14"/>
        </StackPanel>

        <Grid Background="#2C3E50" Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Visibility="{Binding IsButtonView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Content="Create Practice" FontSize="20" HorizontalAlignment="Left" Command="{Binding CreateSheetCommand}" Margin="20,0" Height="66" Width="200" Background="Yellow" Cursor="Hand">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                </Button>
                <Button Content="Load Practice" FontSize="20" HorizontalAlignment="Left" Command="{Binding LoadSheetCommand}" Margin="20,0" Height="66" Width="200" Background="#27AE60" Cursor="Hand">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="pianorollGrid" Grid.Row="1" Visibility="{Binding IsPianoRollView, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
        </Grid>
    </Grid>
</Window>
