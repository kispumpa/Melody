<Window x:Class="Melody.UI.PracticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Melody.UI"
        mc:Ignorable="d"
        Title="PracticeWindow" WindowState="Maximized" d:DesignHeight="540" d:DesignWidth="960">
    <Grid>
        <TextBox HorizontalAlignment="Left" Margin="400,180,0,0" TextWrapping="Wrap" Text="Practice window" VerticalAlignment="Top" Width="120"/>
        <Button Content="Create Practice" HorizontalAlignment="Left" Command="{Binding CreateSheetCommand}" Margin="338,296,0,0" VerticalAlignment="Top"/>
        <Button Content="Load Practice" HorizontalAlignment="Left" Command="{Binding LoadSheetCommand}" Margin="338,397,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
